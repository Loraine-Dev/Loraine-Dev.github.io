{
  "name": "miloqen-living-imagination",
  "version": "1.0.0-rc.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/render.mjs && vite --host 127.0.0.1 --port 4176",
    "build": "node scripts/render.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4176",
    "test:unit": "node --test tests/geometry.test.ts tests/world-space.test.ts tests/environment-space.test.ts",
    "test:browser": "node tests/world-browser.mjs && node tests/hero-focus.mjs",
    "format": "prettier --write src scripts tests review index.html vite.config.ts tsconfig.json",
    "capture": "node scripts/capture-world.mjs",
    "assets": "node scripts/prepare-world-assets.cjs",
    "test:environment": "node tests/environment-browser.mjs",
    "assets:motion": "node scripts/prepare-motion-assets.cjs",
    "record:environment": "node scripts/record-environment.mjs",
    "test:idle": "node tests/idle-start.mjs && node tests/motion-debug.mjs",
    "verify:idle": "node scripts/verify-idle-motion.mjs && node tests/idle-pixels.mjs",
    "test:flow": "node tests/cloud-flow.mjs && node tests/motion-compare.mjs",
    "assets:cloud": "node scripts/prepare-cloud-bank.cjs",
    "record:flow": "node scripts/record-visible-flow.mjs && node scripts/encode-visible-flow.mjs",
    "assets:godrays": "node scripts/prepare-godrays.cjs",
    "test:godrays": "node tests/integrated-materials.mjs",
    "test:site": "node --test tests/site-build.test.mjs tests/journal.test.mjs tests/channels.test.mjs && node tests/site-browser.mjs",
    "assets:optimized": "node scripts/prepare-optimized-art.mjs",
    "verify:art": "node scripts/verify-art-quality.mjs",
    "test:loading": "node --test tests/optimized-art.test.mjs && node tests/art-loading-browser.mjs",
    "test:living": "node tests/integrated-materials.mjs",
    "legacy:test:godrays": "node tests/godray-study.mjs",
    "assets:living": "node scripts/prepare-material-response.cjs",
    "test:masks": "node --test tests/living-mask.test.mjs tests/material-regions.test.mjs",
    "check": "npm run build && npm run test:unit && npm run test:masks && node --test tests/site-build.test.mjs tests/journal.test.mjs tests/channels.test.mjs tests/optimized-art.test.mjs tests/sample-materials.test.mjs tests/content-rehearsal.test.mjs tests/browser-runner.test.mjs && npm run test:release",
    "test:browser:ci": "node scripts/browser-ci.mjs",
    "test:content": "node --test tests/content-rehearsal.test.mjs",
    "test:rollback": "node scripts/verify-rollback.mjs",
    "assets:materials": "node scripts/prepare-sample-materials.mjs",
    "test:release": "node scripts/verify-release.mjs",
    "review:v1": "node scripts/prepare-v1-review.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "lighthouse": "13.5.0",
    "playwright": "1.62.1",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
